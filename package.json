{
  "name": "threejs-converters",
  "version": "0.1.0",
  "description": "One-file Node converters: internet finds -> three.js ingame assets",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bash examples/ci.sh",
    "coverage": "c8 npm test",
    "download": "node converters/download.js",
    "report": "node converters/gltf-report.js",
    "optimize": "node converters/glb-optimize.js",
    "texture": "node converters/texture-convert.js",
    "obj2glb": "node converters/obj-to-glb.js",
    "ply2glb": "node converters/ply-to-glb.js",
    "dae2glb": "node converters/dae-to-glb.js",
    "3ds2glb": "node converters/3ds-to-glb.js",
    "pack": "node converters/gltf-pack.js",
    "pk3": "node converters/pk3-to-dir.js",
    "md3": "node converters/md3-to-glb.js",
    "md2": "node converters/md2-to-glb.js",
    "vox": "node converters/vox-to-glb.js",
    "minecraft": "node converters/minecraft-to-glb.js",
    "usdz": "node converters/usdz-export.js",
    "draco": "node converters/draco-compress.js",
    "atlas": "node converters/texture-atlas.js",
    "cubemap": "node converters/hdr-to-cubemap.js",
    "svg": "node converters/svg-to-glb.js",
    "font": "node converters/font-to-glb.js",
    "3mf": "node converters/3mf-to-glb.js",
    "exr": "node converters/exr-to-hdr.js",
    "lod": "node converters/lod-generate.js",
    "cost": "node converters/material-cost.js",
    "merge": "node converters/glb-merge.js",
    "split": "node converters/glb-split.js",
    "anim": "node converters/anim-trim.js",
    "proxy": "node converters/collision-proxy.js",
    "material": "node converters/material-normalize.js",
    "gate": "node converters/budget-gate.js"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.0",
    "three": "^0.186"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velkymx/threejs-converters.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/velkymx/threejs-converters/issues"
  },
  "homepage": "https://github.com/velkymx/threejs-converters#readme"
}
